# ==============================================================
# MOSMAC Frontend Environment Template (Netlify Site Settings)
# ==============================================================

# Backend API Endpoint:
# Set this in Netlify -> Site configuration -> Environment variables
VITE_API_BASE_URL=https://mosmac.onrender.com/api/v1

# Storefront Branding Name
VITE_APP_NAME=MOSMAC

# Canonical Site URL (Replace with your actual Netlify site URL)
VITE_SITE_URL=https://mosmac.netlify.app

# Razorpay Payment Gateway Public Key (starts with rzp_live_ or rzp_test_)
VITE_RAZORPAY_KEY_ID=rzp_test_mock_sandbox_key

# Optional: Sentry Client DSN for error logging
# VITE_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project
